var language_override := ""


func language() -> String:
	if language_override != "":
		return language_override
	return "fr" if TranslationServer.get_locale().to_lower().begins_with("fr") else "en"


func t(key: String) -> String:
	var table: Dictionary = STRINGS.get(language(), STRINGS["en"])
	return str(table.get(key, STRINGS["en"].get(key, key)))
