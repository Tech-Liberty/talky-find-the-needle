{
  "port": 7421,
  "gamePort": 7422,
  "token": "change-me-to-a-long-random-string",
  "jobTtlSeconds": 900,
  "httpAllowedHosts": [
    "*.liberty-talk.com"
  ],
  "httpTargets": {
    "lt_report": {
      "url": "https://api.liberty-talk.com/webhooks/workflow/PASTE_THE_TOKEN_OF_YOUR_INCOMING_WEBHOOK",
      "headers": {
        "X-Webhook-Secret": "PASTE_THE_SECRET_OF_YOUR_INCOMING_WEBHOOK"
      }
    }
  },
  "settings": {
    "language": "auto",
    "anonymousName": "Anonymous",
    "maxJobsPerMinute": 30,
    "bitsMultiplier": 10,
    "blockedActions": [],
    "safeMode": false,
    "safeModeBlocks": [
      "yeet",
      "spin",
      "drunk",
      "upside_down",
      "quake_pro",
      "blackout"
    ]
  },
  "webhooks": {
    "follow": {
      "workflow": "new_follower"
    },
    "sub": {
      "workflow": "new_sub"
    },
    "gift": {
      "workflow": "gift_subs"
    },
    "bits": {
      "workflow": "bits"
    },
    "raid": {
      "workflow": "raid"
    },
    "donation": {
      "workflow": "donation"
    },
    "superchat": {
      "workflow": "donation"
    },
    "member": {
      "workflow": "new_sub"
    },
    "command": {
      "workflow": "chat_hay"
    },
    "message": {
      "workflow": "message"
    },
    "points": {
      "routes": [
        {
          "when": {
            "reward_title": {
              "matches": "foin|\\bhay\\b"
            }
          },
          "workflow": "points_hay"
        },
        {
          "when": {
            "reward_title": {
              "matches": "canard|duck"
            }
          },
          "workflow": "points_duck"
        },
        {
          "when": {
            "reward_title": {
              "matches": "prout|fart"
            }
          },
          "workflow": "points_fart"
        },
        {
          "when": {
            "reward_title": {
              "matches": "aiguille|needle"
            }
          },
          "workflow": "points_fake_needle"
        },
        {
          "when": {
            "reward_title": {
              "matches": "éjecte|launch"
            }
          },
          "workflow": "points_yeet"
        },
        {
          "when": {
            "reward_title": {
              "matches": "aimant|magnet"
            }
          },
          "workflow": "points_magnet"
        },
        {
          "when": {
            "reward_title": {
              "matches": "lévitation|levitat"
            }
          },
          "workflow": "points_levitate"
        },
        {
          "when": {
            "reward_title": {
              "matches": "bourré|drunk"
            }
          },
          "workflow": "points_drunk"
        },
        {
          "when": {
            "reward_title": {
              "matches": "envers|upside"
            }
          },
          "workflow": "points_upside_down"
        },
        {
          "when": {
            "reward_title": {
              "matches": "zoom"
            }
          },
          "workflow": "points_quake_pro"
        },
        {
          "when": {
            "reward_title": {
              "matches": "toupie|spin"
            }
          },
          "workflow": "points_spin"
        },
        {
          "when": {
            "reward_title": {
              "matches": "panne|blackout"
            }
          },
          "workflow": "points_blackout"
        },
        {
          "when": {
            "reward_title": {
              "matches": "\\bvent\\b|\\bwind\\b"
            }
          },
          "workflow": "points_gust"
        }
      ]
    }
  },
  "gameEvents": {
    "needle_found": [
      "on_needle_found",
      "report_to_libertytalk"
    ],
    "pile_replaced": "on_new_pile"
  },
  "workflows": {
    "new_follower": {
      "menu": {
        "label": "Follow",
        "group": "events"
      },
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} lands on the pile!"
        },
        {
          "action": "duck",
          "name": "{{user}}",
          "size": 0.8
        }
      ]
    },
    "new_sub": {
      "menu": {
        "label": "Subscription",
        "group": "events"
      },
      "steps": [
        {
          "set": {
            "tierLevel": "{{tier | default:1000 | tier}}"
          }
        },
        {
          "action": "notify",
          "text": "{{user}} subscribed: giant duck!",
          "color": "#ffd54f"
        },
        {
          "action": "duck",
          "name": "{{user}}",
          "size": "{{tierLevel | add:1 | mul:1.5}}",
          "seconds": 900
        }
      ]
    },
    "gift_subs": {
      "menu": {
        "label": "10 gifted subs",
        "group": "events",
        "payload": {
          "total": 10
        }
      },
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} gifts {{total | default:1}} subs: DUCK RAIN!",
          "color": "#ff8a65"
        },
        {
          "action": "duck",
          "name": "{{user}}",
          "count": "{{total | default:1 | clamp:1:30}}",
          "size": 1.2
        }
      ]
    },
    "bits": {
      "menu": {
        "label": "500 bits",
        "group": "events",
        "payload": {
          "bits": 500
        }
      },
      "steps": [
        {
          "if": {
            "bits": {
              "gte": 1000
            }
          },
          "then": [
            {
              "action": "notify",
              "text": "{{bits}} bits from {{user}}: AVALANCHE!",
              "color": "#ff1744"
            },
            {
              "action": "hay_rain",
              "count": "{{bitsMultiplied | clamp:10:5000}}"
            },
            {
              "action": "duck",
              "name": "{{user}}",
              "size": 4
            }
          ],
          "else": [
            {
              "action": "notify",
              "text": "{{user}} adds hay ({{bits}} bits)"
            },
            {
              "action": "hay_rain",
              "count": "{{bitsMultiplied | clamp:10:5000}}"
            }
          ]
        }
      ]
    },
    "raid": {
      "menu": {
        "label": "Raid (50 viewers)",
        "group": "events",
        "payload": {
          "viewers": 50
        }
      },
      "steps": [
        {
          "action": "notify",
          "text": "HAY RAID: {{user}} arrives with {{viewers | default:1}} viewers!",
          "color": "#b388ff"
        },
        {
          "action": "hay_rain",
          "count": "{{viewers | default:1 | mul:5 | clamp:30:300}}"
        },
        {
          "action": "duck",
          "name": "{{user}}",
          "count": "{{viewers | default:1 | div:5 | ceil | clamp:1:30}}"
        },
        {
          "action": "yeet",
          "force": 12
        }
      ]
    },
    "donation": {
      "menu": {
        "label": "Donation",
        "group": "events"
      },
      "steps": [
        {
          "action": "notify",
          "text": "Thanks {{user}}!",
          "color": "#69f0ae"
        },
        {
          "action": "duck",
          "name": "{{user}}",
          "size": 5,
          "seconds": 900
        }
      ]
    },
    "chat_hay": {
      "cooldownSeconds": 30,
      "steps": [
        {
          "action": "hay_rain",
          "count": 10
        }
      ]
    },
    "points_hay": {
      "menu": {
        "label": "Hay delivery",
        "group": "hay"
      },
      "cooldownSeconds": 30,
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} orders a hay delivery"
        },
        {
          "action": "hay_rain",
          "count": 100
        }
      ]
    },
    "points_duck": {
      "menu": {
        "label": "Duck",
        "group": "ducks"
      },
      "cooldownSeconds": 20,
      "steps": [
        {
          "action": "duck",
          "name": "{{user}}",
          "size": "{{'' | pick:0.6:1:1:2:3}}"
        }
      ]
    },
    "points_fart": {
      "menu": {
        "label": "Fart",
        "group": "troll"
      },
      "cooldownSeconds": 30,
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} let one rip in the barn"
        },
        {
          "action": "hay_rain",
          "count": 40,
          "on": "player",
          "radius": 6,
          "height": 2
        },
        {
          "action": "sound",
          "name": "fart"
        },
        {
          "action": "gust",
          "strength": 6,
          "radius": 10
        }
      ]
    },
    "points_fake_needle": {
      "menu": {
        "label": "Fake needle",
        "group": "troll"
      },
      "cooldownSeconds": 180,
      "steps": [
        {
          "action": "sound",
          "name": "beep"
        },
        {
          "action": "wait",
          "seconds": 0.9
        },
        {
          "action": "sound",
          "name": "beep"
        },
        {
          "action": "wait",
          "seconds": 0.7
        },
        {
          "action": "sound",
          "name": "beep"
        },
        {
          "action": "wait",
          "seconds": 0.5
        },
        {
          "action": "sound",
          "name": "beep"
        },
        {
          "action": "wait",
          "seconds": 0.3
        },
        {
          "repeat": 8,
          "steps": [
            {
              "action": "sound",
              "name": "beep",
              "pitch": 1.2
            },
            {
              "action": "wait",
              "seconds": 0.12
            }
          ]
        },
        {
          "action": "notify",
          "text": "NEEDLE FOUND!",
          "color": "#ffd54f",
          "seconds": 3
        },
        {
          "action": "wait",
          "seconds": 3
        },
        {
          "action": "sound",
          "name": "quack"
        },
        {
          "action": "notify",
          "text": "... nope. Thanks {{user}}.",
          "seconds": 4
        }
      ]
    },
    "points_yeet": {
      "menu": {
        "label": "Launch",
        "group": "player"
      },
      "cooldownSeconds": 60,
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} sends you flying!",
          "color": "#ff8a65"
        },
        {
          "action": "yeet",
          "force": 16
        }
      ]
    },
    "points_magnet": {
      "menu": {
        "label": "Hay magnet",
        "group": "hay"
      },
      "cooldownSeconds": 120,
      "steps": [
        {
          "action": "notify",
          "text": "{{user}}: all the hay loves you",
          "color": "#ff80ab"
        },
        {
          "action": "hay_rain",
          "count": 120,
          "on": "player",
          "radius": 10
        },
        {
          "action": "magnet",
          "seconds": 8
        }
      ]
    },
    "points_levitate": {
      "menu": {
        "label": "Levitation",
        "group": "hay"
      },
      "cooldownSeconds": 120,
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} turns off gravity for the hay",
          "color": "#b388ff"
        },
        {
          "action": "hay_rain",
          "count": 120,
          "on": "player",
          "radius": 10,
          "height": 2
        },
        {
          "action": "levitate",
          "seconds": 8
        }
      ]
    },
    "points_drunk": {
      "menu": {
        "label": "Drunk",
        "group": "screen"
      },
      "cooldownSeconds": 180,
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} buys a round",
          "color": "#ffab40"
        },
        {
          "action": "drunk",
          "seconds": 20
        }
      ]
    },
    "points_upside_down": {
      "menu": {
        "label": "Upside down",
        "group": "screen"
      },
      "cooldownSeconds": 180,
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} flips the screen",
          "color": "#ffab40"
        },
        {
          "action": "upside_down",
          "seconds": 12
        }
      ]
    },
    "points_quake_pro": {
      "menu": {
        "label": "Extreme zoom",
        "group": "screen"
      },
      "cooldownSeconds": 120,
      "steps": [
        {
          "action": "quake_pro",
          "seconds": 12
        }
      ]
    },
    "points_spin": {
      "menu": {
        "label": "Spin",
        "group": "player"
      },
      "cooldownSeconds": 90,
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} spins you around"
        },
        {
          "action": "spin",
          "turns": 5,
          "seconds": 2.5
        }
      ]
    },
    "points_blackout": {
      "menu": {
        "label": "Blackout",
        "group": "screen"
      },
      "cooldownSeconds": 180,
      "steps": [
        {
          "action": "blackout",
          "seconds": 4,
          "text": "{{user}} didn't pay the power bill"
        }
      ]
    },
    "points_gust": {
      "menu": {
        "label": "Gust of wind",
        "group": "hay"
      },
      "cooldownSeconds": 60,
      "steps": [
        {
          "action": "notify",
          "text": "{{user}} blows on the hay!"
        },
        {
          "action": "hay_rain",
          "count": 60,
          "on": "player",
          "radius": 8,
          "height": 2
        },
        {
          "action": "gust",
          "strength": 10,
          "radius": 15
        }
      ]
    },
    "message": {
      "userCooldownSeconds": 10,
      "steps": [
        {
          "action": "message",
          "author": "{{user}}",
          "text": "{{text | default:message}}"
        }
      ]
    },
    "clear_ducks": {
      "menu": {
        "label": "Remove the ducks",
        "group": "ducks"
      },
      "steps": [
        {
          "action": "clear_ducks"
        }
      ]
    },
    "on_needle_found": {
      "steps": [
        {
          "action": "notify",
          "text": "NEEDLE FOUND!",
          "color": "#ffd54f",
          "seconds": 6
        }
      ]
    },
    "on_new_pile": {
      "steps": [
        {
          "action": "log",
          "message": "new hay pile"
        }
      ]
    },
    "report_to_libertytalk": {
      "enabled": false,
      "steps": [
        {
          "action": "http",
          "target": "lt_report",
          "body": {
            "event": "{{event}}",
            "needlesFound": "{{needlesFound}}"
          }
        }
      ]
    },
    "dev_menu": {
      "steps": [
        {
          "action": "menu",
          "open": true,
          "tab": "{{tab | default:effects}}",
          "language": "{{language}}"
        }
      ]
    },
    "dev_close": {
      "steps": [
        {
          "action": "menu",
          "open": false
        }
      ]
    },
    "dev_reload": {
      "steps": [
        {
          "action": "reload_menu"
        }
      ]
    },
    "dev_shot": {
      "steps": [
        {
          "action": "screenshot"
        }
      ]
    }
  }
}
